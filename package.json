{
  "name": "myrmidon-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun scripts/test.ts",
    "test:changed": "bun scripts/test.ts --changed",
    "test:serial": "bun test --timeout 30000",
    "test:group": "bun scripts/test-group.ts",
    "test:integration": "bun scripts/test-group.ts integration",
    "test:security": "bun scripts/test-group.ts security",
    "test:perf": "bun scripts/test-group.ts perf",
    "smoke:desktop": "bun scripts/smoke-desktop.ts",
    "check": "bun run typecheck && bun run lint && bun scripts/test.ts",
    "myr": "bun apps/cli/src/main.ts",
    "dev": "bun --watch apps/cli/src/main.ts serve --port 4318 --dev --debug",
    "eval": "bun apps/eval/src/main.ts",
    "desktop": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:sidecar": "bun run --cwd apps/desktop sidecar",
    "desktop:typecheck": "bun run --cwd apps/desktop typecheck"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "bun-plugin-tailwind": "0.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "patchedDependencies": {
    "@oh-my-pi/pi-ai@18.8.8": "patches/@oh-my-pi%2Fpi-ai@18.8.8.patch",
    "@oh-my-pi/pi-coding-agent@18.8.8": "patches/@oh-my-pi%2Fpi-coding-agent@18.8.8.patch",
    "@oh-my-pi/pi-catalog@18.8.8": "patches/@oh-my-pi%2Fpi-catalog@18.8.8.patch"
  }
}
